string name = "hermes";
integer age = 45;
bool is_male = true;

if is_male {
	io::write("is male");
} or_if is_male == false {
	io::write("is female");
} or {
	io::write("default value");
}

string helloName (string name) {
	::("hello, $name !");
}

string hello = helloName("hermes");
io::write(hello);

//function with no return
writeScreen () {
	io::write("hello, world");
}

writeScreen();

//array
[string] names = ["hermes", "lucas"];
for index, value in names {
	io::write(value);
}

names:push("gusta");
names:pop();
names:removeValue("hermes");
io::write(names:first());
io::write(names:last());
io::write(names)
