bool isPalindrome (integer n) {
    [integer] nArr = n.toArray()
    [integer] new = []
    bool final = false

    // inverte
    for index, _ :: nArr {
        new.push(nArr[nArr.length() - 1 - index])
    }

    // verifica
    for index, value :: nArr {
        if value != new[index] {
            final = false
        } or {
            final = true
        }
    }

    ::(final)
}

io::write(isPalindrome(121))